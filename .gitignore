# ============================================================
# Python
# ============================================================

__pycache__/
**/__pycache__/

*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/


# ============================================================
# LaTeX
# ============================================================

# Compilation / auxiliary files
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex
*.synctex.gz

# SyncTeX backup files generated by TeXstudio / editors
*.synctex-*.gz

# Temporary LaTeX files
*.dvi
*.ps

# NOTE:
# Final PDF files are intentionally NOT ignored.


# ============================================================
# MATLAB / Simulink
# ============================================================

# MATLAB autosave / backup files
*.asv
*.m~
*.autosave

# MATLAB generated code / cache
slprj/
codegen/
*.mex*
*.pdb

# Simulink cache / generated files
*.slxc
*.sldd~

# NOTE:
# .m and .mdl source files are intentionally NOT ignored.


# ============================================================
# IDE / Editor
# ============================================================

.vscode/
.idea/

# Vim / Emacs temporary files
*~
.#*


# ============================================================
# Operating System
# ============================================================

.DS_Store
.AppleDouble
.LSOverride

Thumbs.db
Desktop.ini


# ============================================================
# Project temporary files
# ============================================================

*.tmp
*.temp
